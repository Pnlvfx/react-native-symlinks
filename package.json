{
  "name": "react-native-symlinks",
  "version": "1.0.0",
  "description": "Link local packages with rn metro",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pnlvfx/react-native-symlinks.git"
  },
  "license": "MIT",
  "author": {
    "email": "simonegauli@gmail.com",
    "name": "Simone Gauli"
  },
  "sideEffects": false,
  "type": "module",
  "exports": {
    "./*": {
      "types": "./dist/*/index.d.ts",
      "import": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rimraf dist && eslint && tsc -p tsconfig.build.json",
    "lint": "eslint",
    "prepack": "yarn build",
    "prepare": "husky",
    "tsc": "tsc --noEmit",
    "update": "yarn upgrade-interactive"
  },
  "dependencies": {
    "escape-string-regexp": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/config-helpers": "^0.6.0",
    "@goatjs/node-eslint": "^2.31.0",
    "@goatjs/rimraf": "^2.11.0",
    "@goatjs/typescript-config": "^2.2.0",
    "@react-native/metro-config": "^0.86.0",
    "@types/node": "^25.9.3",
    "eslint": "^10.5.0",
    "prettier": "^3.8.4",
    "typescript": "^6.0.3"
  },
  "packageManager": "yarn@4.16.0+sha512.5374c94eb4ef6aa8188fb112f20c1aa6569f248d676c5e576e1fd2a1a4d8d87a96df65d9dfe1c2a0252cbe38bda46cf18d955005b81b43cc7607a5c9d56fd2b6"
}
